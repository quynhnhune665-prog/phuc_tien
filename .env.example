# Database
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=phuc_tien_dev
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL=false

# Server
NODE_ENV=development
PORT=3847

# Search Provider (Phase 1: fixture, Phase 2: bing)
SEARCH_PROVIDER=fixture
BING_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Crawler
CRAWLER_TIMEOUT=30000
CRAWLER_MAX_RETRIES=3
CRAWLER_RATE_LIMIT_MS=1000
CRAWLER_USER_AGENT=PTien-Math-Hunter/1.0 (+http://ptien.math)

# Deduplication
DEDUP_EXACT_ENABLED=true
DEDUP_NORMALIZE_ENABLED=true
DEDUP_SIMILARITY_THRESHOLD=0.85
DEDUP_SEMANTIC_ENABLED=false
DEDUP_SEMANTIC_THRESHOLD=0.90

# Limits (Phase 1: small, Phase 3: scalable)
MAX_SEARCH_QUERIES=50
MAX_URLS_PER_QUERY=100
MAX_CRAWL_WORKERS=3
MAX_PROBLEMS_TARGET=null

# Logging
LOG_LEVEL=info
