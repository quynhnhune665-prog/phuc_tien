{
  "name": "phuc_tien-math-hunter",
  "version": "0.1.0",
  "description": "PTIEN Math Hunter - Real problem collection, classification, and workbook generation from verified sources",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node src/database/init.js",
    "db:seed:fixture:10": "node src/database/seed-fixture.js 10",
    "db:seed:fixture:20": "node src/database/seed-fixture.js 20",
    "db:seed:fixture:100": "node src/database/seed-fixture.js 100",
    "test:e2e:10": "NODE_ENV=test node tests/e2e-10.test.js",
    "test:e2e:20": "NODE_ENV=test node tests/e2e-20.test.js",
    "test:e2e:100": "NODE_ENV=test node tests/e2e-100.test.js",
    "test:extractor": "NODE_ENV=test node tests/extractor.test.js",
    "test:classifier": "NODE_ENV=test node tests/classifier.test.js",
    "test:dedup": "NODE_ENV=test node tests/dedup.test.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres"
  },
  "keywords": [
    "math",
    "education",
    "knowledge-acquisition",
    "web-crawler",
    "deduplication"
  ],
  "author": "quynhnhune665-prog",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "pg-promise": "^11.5.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "pdfparse": "^1.2.0",
    "docx": "^8.5.0",
    "winston": "^3.11.0",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  }
}
